# Copy to .env and fill in to enable live (LLM) mode.
# Demo mode (--demo) needs none of these.

OPENAI_API_KEY=your_api_key_here

# Optional: point at any OpenAI-compatible endpoint
# (OpenAI default, Azure OpenAI, OpenRouter, or a local model via Ollama/LM Studio)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
